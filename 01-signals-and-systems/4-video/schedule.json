  {
   "line": 12,
   "text": "Loud callers sound like loud people again. Then a new ticket arrives: I can hear myself. Every word comes back, faint, a quarter of a second later. That's the next bug.",
   "clip": "/Users/cleiton.loiola/personal/lessons/dsp-oppenheim/01-signals-and-systems/4-video/vo-redo/line05.wav",
   "at": 138.79,
   "start": 138.79,
   "end": 145.61,
   "start_frame": 4164,
   "words": [
    {
     "word": "Loud",
     "frame": 4164
